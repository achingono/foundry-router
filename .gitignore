# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover
.pytest_cache/
.hypothesis/

# Type checking
.mypy_cache/
.dmypy.json
dmypy.json

# Ruff
.ruff_cache/

# Jupyter Notebook
.ipynb_checkpoints/

# Environments
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Temporary
tmp/
temp/

# Docker
.docker/

# Environment-specific Bicep parameter overrides. These carry subscription, tenant,
# resource group, registry and vault names for a real environment - keep them local.
# Committed parameter files under infra/ must contain placeholders only.
*.local.json

# Operator-managed Google credentials; never include in commits.
infra/google-aistudio-keys.json

# Mutable advisory locks for live-validation ledgers; ledger JSON is audit evidence.
docs/plans/google-ai-studio-tools-multimodal/live-runner/*.json.lock
docs/plans/google-ai-routing-order/*.json.lock

# Bicep build output (regenerated by `az bicep build`; never commit)
infra/main.json

# Local Azurite emulator state
AzuriteConfig
__azurite_db_*.json
__blobstorage__/
__queuestorage__/

# Mutable lock for the serialized compatible verification stage.
docs/plans/google-compatible-text-verification/stage.lock
docs/plans/table-real-inference/ledger.json.lock
docs/plans/azure-cost-live-verification/diagnostic-started.json.lock
docs/plans/azure-cost-schema-diagnosis/diagnostic-started.json.lock
docs/plans/azure-cost-currency/diagnostic-started.json.lock
docs/plans/azure-cost-http-diagnosis/diagnostic-started.json.lock

# Operator-private captures and account-identifying quota inventories.
# Keep originals local; .gitignore alone does not untrack existing files.
private/
screenshots/
/docs/plans/google-ai-studio-capacity-inventory/quotas/
/docs/plans/google-ai-studio-capacity-inventory/inventory.csv
/docs/plans/google-ai-studio-capacity-inventory/quotas.csv
/docs/plans/google-ai-studio-capacity-inventory/quotas.md

# Local plan captures; exact exceptions are fixtures read by offline tests.
/docs/plans/**/*.json
/docs/plans/**/*.txt
/docs/plans/**/*.lock
!/docs/plans/google-ai-studio-tools-multimodal/live-discovery.json
!/docs/plans/google-ai-studio-tools-multimodal/live-runner/manifest.json
!/docs/plans/google-ai-routing-order/ledger-native-text-2026-10-08.json
!/docs/plans/google-compatible-stream-lifecycle/results.json
!/docs/plans/google-stream-terminal-amendment/results.json
!/docs/plans/google-final-cancellation/prerequisite-manifest.json
!/docs/plans/google-final-cancellation/ledger-baseline.json
!/docs/plans/google-compatible-text-verification/ledger-baseline.json
!/docs/plans/google-compatible-envelope/ledger-baseline.json
