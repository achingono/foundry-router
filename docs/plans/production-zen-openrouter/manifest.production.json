      "provider": "opencode_zen",
      "deployment": "gpt-5.4-mini",
      "input_per_million": 0.75,
      "output_per_million": 4.5
    },
    {
      "id": "production-zen-stream",
      "pool": "gpt-5.4-mini-zen",
      "operation": "responses",
      "stream": true,
      "provider": "opencode_zen",
      "deployment": "gpt-5.4-mini",
      "input_per_million": 0.75,
      "output_per_million": 4.5
    }
  ],
  "evidence_scope": "deployed-public-admin-v1"
}
