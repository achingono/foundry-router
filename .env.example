# Foundry Router configuration example. JSON values must remain on one line.
# Never commit .env or real credentials.

FOUNDRY_BACKENDS_JSON='{"sub_a":{"endpoint":"https://your-foundry-a.openai.azure.com","credential":"replace-me","region":"eastus","deployment":"gpt-4"},"sub_b":{"endpoint":"https://your-foundry-b.openai.azure.com","credential":"replace-me","region":"westus2","deployment":"gpt-4"}}'
FOUNDRY_MODELS_JSON='{"gpt-5.6-luna":{"backends":{"sub_a":1.0}},"gpt-5.4":{"backends":{"sub_a":1.0,"sub_b":1.0}},"text-embedding-3-large":{"backends":{"sub_a":1.0,"sub_b":1.0}}}'

FOUNDRY_CLIENT_API_KEYS_JSON='["replace-client-key"]'
FOUNDRY_ADMIN_API_KEYS_JSON='["replace-admin-key"]'

FOUNDRY_RECONCILIATION_INTERVAL_MINUTES=10
FOUNDRY_MIN_CREDIT_RESERVE_USD=10.0
FOUNDRY_MIN_CREDIT_RESERVE_PERCENT=5.0
FOUNDRY_RETRY_ATTEMPTS=2
FOUNDRY_RETRY_MAX_DELAY_SECONDS=30.0
FOUNDRY_LOG_LEVEL=INFO

# Prices are local estimates per million tokens. Zero is valid for a dimension
# that is not charged, such as embedding output tokens.
FOUNDRY_PRICING_JSON='{"gpt-5.6-luna":{"input_per_million":10.0,"output_per_million":30.0},"gpt-5.4":{"input_per_million":5.0,"output_per_million":15.0},"text-embedding-3-large":{"input_per_million":0.13,"output_per_million":0.0}}'
FOUNDRY_BACKEND_CYCLE_START_DAY_JSON='{"sub_a":1,"sub_b":15}'
FOUNDRY_PROTECTED_EMERGENCY_FALLBACK=false
